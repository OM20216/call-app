# Copy this file to ".env" and fill in the values.
# Leave a section blank and the app runs that part in DEMO mode
# (sample address book / no real phone rings) so you can try the flow.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Microsoft Graph  ->  the address book (people + phone numbers)
# Azure App registration with APPLICATION permission:
#     User.Read.All      (then click "Grant admin consent")
# Values come from: Azure Portal -> App registrations -> your app
# ------------------------------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ------------------------------------------------------------------
# Twilio  ->  makes the HR's own mobile ring, then dials the contact
# (classic click-to-call bridge). From https://console.twilio.com
# TWILIO_FROM_NUMBER must be a number you own in Twilio, in +E.164 form.
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
