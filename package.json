{
  "name": "hr-click-to-call",
  "private": true,
  "version": "1.0.0",
  "description": "HR click-to-call. Office copy at http://172.16.0.238:4200 (worker/local), cloud copy on Cloudflare Workers",
  "scripts": {
    "start": "node scripts/open-app.mjs",
    "test": "npm --prefix worker run check && node worker/scripts/smoke.mjs",
    "office": "node worker/local/server.mjs",
    "office:install": "powershell -NoProfile -ExecutionPolicy Bypass -File worker/local/install.ps1",
    "office:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File worker/local/install.ps1 -Uninstall",
    "start:legacy": "npm --prefix simple start",
    "setup:legacy": "npm --prefix simple install",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=22"
  }
}
